{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.0.0",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "*://motamem.org/*",
    "*://*.motamem.org/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://motamem.org/*",
        "*://*.motamem.org/*"
      ],
      "js": ["shared/utils.js", "shared/i18n.js", "content/content-script.js"],
      "css": ["content/content-script.css"]
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icons/me-icon-16x16.png",
      "24": "assets/icons/me-icon-24x24.png",
      "32": "assets/icons/me-icon-32x32.png"
    }
  },
  "icons": {
    "16": "assets/icons/me-icon-16x16.png",
    "32": "assets/icons/me-icon-32x32.png",
    "48": "assets/icons/me-icon-48x48.png",
    "128": "assets/icons/me-icon-128x128.png"
  }
}

